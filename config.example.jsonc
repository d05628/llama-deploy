{
  // 在 Web 管理器中选择模型后，这些字段会自动写入本地 config.jsonc。
  "model": {
    "repo_id": "",
    "model_file": "",
    "mmproj_file": "",
    "mmproj_use_xet": true,
    "mmproj_map": {},
    "mmproj_bindings": {}
  },
  "engine": {
    // auto 按 GGUF 类型选择：PQ2_0/PTQ1_0 使用独立 Prism fork。
    "provider": "auto",
    // 可选：指定已登记的引擎版本目录，回退时改回旧目录即可。
    "directory": ""
  },
  "download": {
    "hf_mirror": "https://hf-mirror.com",
    // 可选；留空时使用 GitHub 官方直链，镜像失败也会自动回退直链。
    "github_mirror": "",
    "timeout": 300,
    "retries": 3
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "threads": 0,
    "ctx_size": 0,
    "enable_thinking": false,
    "reasoning_budget": 512
  },
  "compat": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 11434,
    "upstream_url": "http://127.0.0.1:8080",
    "model_alias": "llama-deploy-local",
    "api_key": "local-no-key-needed",
    "claude_tool_mode": "repair",
    "request_timeout": 600
  },
  "gpu": {
    "backend": "auto",
    "gpu_layers": -1,
    "flash_attention": true,
    // CUDA 多卡策略：auto 小模型用单卡，需要更多显存时才拆分；off 单卡；force 强制多卡。
    "multi_gpu": "auto",
    // auto 按可用资源选择主卡；也可填 NVIDIA 设备编号或 GPU UUID。
    "main_gpu": "auto",
    "split_mode": "layer",
    // 留空按可用显存自动分配；非负数按引擎设备顺序填写，至少一项 > 0，例如 "2,1"。
    "tensor_split": "",
    // 多卡规划时每张卡额外预留 MiB；与 TTS、VRM 等共用设备时可提高。
    "reserve_mb": 1024
  },
  "sampling": {
    "temperature": 0.7,
    "top_k": 20,
    "top_p": 0.8,
    "presence_penalty": 1.5,
    "max_tokens": 2048
  },
  "performance": {
    // auto 会按 GPU/模型自适应；maximum 更激进；compatible 预留更多显存。
    "profile": "auto",
    "parallel": 1,
    "threads_batch": 0,
    "batch_size": 0,
    "ubatch_size": 0,
    "fit_target_mb": 0,
    "priority": 2,
    "priority_batch": 2,
    "cache_reuse": 512,
    "auto_gpu_layers": true,
    "cache_type_k": "auto",
    "cache_type_v": "auto",
    "spec_type": "off",
    "spec_draft_n_max": 2,
    "min_ctx_size": 8192,
    "spec_draft_ngl": "auto",
    "allow_experimental_mtp": false,
    "kv_unified": true,
    "ctx_checkpoints": 32,
    "cpu_moe": false,
    "n_cpu_moe": 0
  },
  "build": {
    "use_openblas": true,
    "jobs": 0
  },
  "ui": {
    "language": "zh",
    "verbose": true
  }
}
